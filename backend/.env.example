# ============================================================
# backend/.env.example – copy to backend/.env and customise
# ============================================================

# JWT signing secret (REQUIRED in production).
# The app runs with a built-in development default if this is
# not set, but prints a WARNING at startup. Never use the
# default in a real deployment.
TRIAGE_SECRET_KEY=change-me-to-a-long-random-secret

# Optional: set to "1" to disable the background shift-apply
# task (useful during automated tests or CI environments).
# TRIAGE_DISABLE_BACKGROUND=0
