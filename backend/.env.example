# Set this in the shell/environment before starting the backend.
# Generate a unique secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not commit the real value to Git.
TRIAGE_SECRET_KEY=

# Comma-separated trusted frontend origins (do not use * with credentials).
TRIAGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
